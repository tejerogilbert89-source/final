/* LibraryFines - single-file PHP app (PHP 7.4+, SQLite via PDO)
   Run: php -S localhost:8000   (or place in htdocs and open /index.php) */
if (session_status() !== PHP_SESSION_ACTIVE) {
    session_start();
}
date_default_timezone_set('Asia/Manila');
const RATE = 5; // peso fine per overdue day

if (!extension_loaded('pdo_sqlite')) {
    http_response_code(500);
    die('The PHP "pdo_sqlite" extension is not enabled. In XAMPP, open php.ini, '
      . 'remove the leading ";" from ";extension=pdo_sqlite", then restart Apache.');
}

try {
    $db = new PDO('sqlite:' . __DIR__ . '/library.db');
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    $db->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);
} catch (PDOException $e) {
    http_response_code(500);
    die('Could not open the fines database. Make sure this folder is writable: ' . __DIR__);
}

$db->exec("CREATE TABLE IF NOT EXISTS loans(
  id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, student_id TEXT, course TEXT NOT NULL,
  year_level TEXT, contact TEXT, book_title TEXT NOT NULL, author TEXT, book_no TEXT,
  borrow_date TEXT NOT NULL, due_date TEXT NOT NULL, returned_on TEXT,
  fine_paid REAL NOT NULL DEFAULT 0, fine_paid_on TEXT)");

/* Migration: older databases won't have these two columns yet.
   fine_total freezes the fine amount at the moment the book record is erased
   (once book_title/due_date etc. are wiped, the fine can no longer be recalculated
   from them). erased marks a record as "book info gone, fine kept". */
$existingCols = array_column($db->query("PRAGMA table_info(loans)")->fetchAll(), 'name');
if (!in_array('fine_total', $existingCols, true)) {
    $db->exec("ALTER TABLE loans ADD COLUMN fine_total REAL");
}
if (!in_array('erased', $existingCols, true)) {
    $db->exec("ALTER TABLE loans ADD COLUMN erased INTEGER NOT NULL DEFAULT 0");
}

$_SESSION['t'] = $_SESSION['t'] ?? bin2hex(random_bytes(16));
function h($s){ return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); }
function money($n){ return '₱' . number_format((float)$n, 2); }
function fdate($d){ return date('M j, Y', strtotime($d)); }
function daysBetween($a, $b){ return (int)(new DateTime($a))->diff(new DateTime($b))->format('%r%a'); }
function plural($n, $w){ return "$n $w" . ($n == 1 ? '' : 's'); }

/* Fine = RATE x days overdue.
   Book not returned: counted up to today (grows daily). Returned: frozen at the return date.
   Erased: frozen at whatever it was the moment the book record was erased (fine_total).
   Fine status: PAID when nothing is left to pay, UNPAID when a balance remains, NO FINE when 0. */
function calc(array $r): array {
  if (!empty($r['erased'])) {
    $fine    = (float)$r['fine_total'];
    $balance = max(0, $fine - (float)$r['fine_paid']);
    $status  = $fine == 0 ? 'NO FINE' : ($balance <= 0 ? 'PAID' : 'UNPAID');
    return ['over' => null, 'fine' => $fine, 'balance' => $balance, 'fstatus' => $status, 'book' => 'Erased'];
  }

  $end     = $r['returned_on'] ?: date('Y-m-d');
  $over    = max(0, daysBetween($r['due_date'], $end));
  $fine    = $over * RATE;
  $balance = max(0, $fine - (float)$r['fine_paid']);
  $status  = $fine == 0 ? 'NO FINE' : ($balance <= 0 ? 'PAID' : 'UNPAID');
  $book    = $r['returned_on'] ? 'Returned' : ($over > 0 ? 'Overdue' : 'Borrowed');
  return ['over' => $over, 'fine' => $fine, 'balance' => $balance, 'fstatus' => $status, 'book' => $book];
}

/* ---------- actions (POST, then redirect) ---------- */
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  if (!hash_equals($_SESSION['t'], $_POST['t'] ?? '')) { http_response_code(400); exit('Invalid session token.'); }
  $a = $_POST['action'] ?? ''; $id = (int)($_POST['id'] ?? 0);
  $back = $_POST['back'] ?? 'index.php'; if (strpos($back, 'index.php') !== 0) $back = 'index.php';
  $today = date('Y-m-d');

  if ($a === 'return') {
    $q = $db->prepare("SELECT erased FROM loans WHERE id=?"); $q->execute([$id]);
    if (($row = $q->fetch()) && !$row['erased']) {
      $db->prepare("UPDATE loans SET returned_on=? WHERE id=?")->execute([$today, $id]);
    }
    header("Location: $back"); exit;
  }
  elseif ($a === 'unreturn') {
    $q = $db->prepare("SELECT erased FROM loans WHERE id=?"); $q->execute([$id]);
    if (($row = $q->fetch()) && !$row['erased']) {
      $db->prepare("UPDATE loans SET returned_on=NULL WHERE id=?")->execute([$id]);
    }
    header("Location: $back"); exit;
  }
  elseif ($a === 'payfine') { // pay the current fine in full -> status becomes PAID automatically
    $q = $db->prepare("SELECT * FROM loans WHERE id=?"); $q->execute([$id]);
    if ($r = $q->fetch()) { $c = calc($r); $db->prepare("UPDATE loans SET fine_paid=?, fine_paid_on=? WHERE id=?")->execute([$c['fine'], $today, $id]); }
    header("Location: $back"); exit;
  }
  elseif ($a === 'erase') {
    // Wipe the borrowed-book details, but freeze and keep the fine so it isn't lost.
    $q = $db->prepare("SELECT * FROM loans WHERE id=?"); $q->execute([$id]);
    if ($r = $q->fetch()) {
      $c = calc($r); // the fine as it stands right now, before the book info disappears
      $db->prepare(
        "UPDATE loans SET
           book_title = '', author = NULL, book_no = NULL,
           course = '', year_level = NULL, contact = NULL,
           fine_total = ?, erased = 1
         WHERE id = ?"
      )->execute([$c['fine'], $id]);
    }
    header("Location: $back"); exit;
  }
  elseif ($a === 'delete') { $db->prepare("DELETE FROM loans WHERE id=?")->execute([$id]); header("Location: $back"); exit; }
  elseif ($a === 'demo') {
    $s = $db->prepare("INSERT INTO loans(name,student_id,course,year_level,contact,book_title,author,book_no,borrow_date,due_date,returned_on,fine_paid,fine_paid_on) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)");
    $d = fn($o) => date('Y-m-d', strtotime("$o days"));
    $s->execute(['Gilbert Tejero','2023-00142','BS Information Technology','3rd Year','0917 555 0142','Introduction to Algorithms','Cormen et al.','QA76.6-0142',$d(-13),$d(-6),null,0,null]);
    $s->execute(['Maria Santos','2022-00871','BS Nursing','4th Year','0928 555 0871','Fundamentals of Nursing','Potter & Perry','RT41-0871',$d(-15),$d(-8),$d(-3),25,$d(-3)]);
    $s->execute(['Paolo Reyes','2024-00310','BS Accountancy','2nd Year','0905 555 0310','Intermediate Accounting','Kieso','HF5635-0310',$d(-2),$d(5),null,0,null]);
    $s->execute(['Angela Cruz','2023-00655','BS Education','3rd Year','0936 555 0655','Philippine History','Zaide','DS668-0655',$d(-12),$d(-5),$d(-1),0,null]);
    header('Location: index.php'); exit;
  }
}

/* ---------- data for the page ---------- */
$f = in_array($_GET['f'] ?? '', ['borrowed','overdue','returned','unpaid','erased'], true) ? $_GET['f'] : 'all';
$search = trim($_GET['q'] ?? '');
$all = $db->query("SELECT * FROM loans")->fetchAll();
foreach ($all as &$r) { $r += calc($r); } unset($r);

$out   = array_filter($all, fn($r) => !$r['returned_on'] && !$r['erased']);
$over  = array_filter($all, fn($r) => $r['book'] === 'Overdue');
$ret   = array_filter($all, fn($r) => $r['returned_on'] && !$r['erased']);
$unpd  = array_filter($all, fn($r) => $r['fstatus'] === 'UNPAID');
$erd   = array_filter($all, fn($r) => $r['erased']);
$sum   = fn($a, $k) => array_sum(array_column($a, $k));
$collected = array_sum(array_map(fn($r) => min((float)$r['fine_paid'], $r['fine']), $all));
$counts = ['all' => count($all), 'borrowed' => count($out), 'overdue' => count($over), 'returned' => count($ret), 'unpaid' => count($unpd), 'erased' => count($erd)];

$rows = array_filter($all, function ($r) use ($f, $search) {
  if ($f === 'borrowed' && ($r['returned_on'] || $r['erased'])) return false;
  if ($f === 'overdue' && $r['book'] !== 'Overdue') return false;
  if ($f === 'returned' && (!$r['returned_on'] || $r['erased'])) return false;
  if ($f === 'unpaid' && $r['fstatus'] !== 'UNPAID') return false;
  if ($f === 'erased' && !$r['erased']) return false;
  return $search === '' || stripos($r['name'].' '.$r['student_id'].' '.$r['course'].' '.$r['book_title'].' '.$r['author'].' '.$r['book_no'], $search) !== false;
});
usort($rows, fn($a, $b) => ($a['returned_on'] ? 1 : 0) <=> ($b['returned_on'] ? 1 : 0) ?: strcmp($a['due_date'], $b['due_date']));
$back = 'index.php' . (!empty($_SERVER['QUERY_STRING']) ? '?' . $_SERVER['QUERY_STRING'] : '');
?>
