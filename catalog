/**
 * Catalog - "Manage Books" screen for staff (admin, librarian).
 *
 * Ported from a standalone mysqli prototype into this project's
 * conventions: PDO + prepared statements only, Auth::requireRole() for
 * access control, and the shared staff layout/design tokens instead of
 * a one-off stylesheet.
 *
 * Schema note: the prototype assumed one flat `books` row per title with
 * a Copies/Available/Borrowed count and a single Call Number / Accession
 * Number. This project's real schema (database/schema.sql) is normalized
 * instead - bib_records (the work) -> editions (an ISBN/format of it) ->
 * items (each physical copy, with its own barcode, accession number,
 * status and location). So:
 *   - search results are grouped by EDITION, with Copies/Available/
 *     Borrowed computed live from items.status (no cached counters to
 *     keep in sync - the prototype's UPDATE...JOIN sync query is gone)
 *   - there's no "Call Number" field in the schema, so ISBN is shown in
 *     its place
 *   - "Accession Number" is per physical copy, not per title, so the
 *     detail view lists every copy instead of a single number
 */
$layout = 'staff';
Auth::requireRole(['admin', 'librarian', 'student']);

$pdo = Database::connection();

/* ── Global stats (across every copy in the library, not just filtered results) ── */
$totals          = $pdo->query("
    SELECT
        COUNT(*) AS total_copies,
        COALESCE(SUM(CASE WHEN status = 'available' THEN 1 ELSE 0 END), 0) AS total_available
    FROM items
")->fetch();
$totalCopies    = (int) $totals['total_copies'];
$totalAvailable = (int) $totals['total_available'];

/* ── Locations for the filter dropdown ── */
$locations = $pdo->query("SELECT id, name FROM locations ORDER BY name")->fetchAll();

/* ── Search handling ── */
$search     = trim($_GET['search'] ?? '');
$locationId = isset($_GET['location']) && $_GET['location'] !== '' ? (int) $_GET['location'] : 0;
$hasQuery   = ($search !== '' || $locationId !== 0);

$resultRows = [];

if ($hasQuery) {
    $sql = "
        SELECT
            e.id AS edition_id,
            b.id AS bib_id,
            b.title,
            b.subtitle,
            e.isbn,
            e.publisher,
            e.publication_year,
            e.edition_statement,
            e.format,
            GROUP_CONCAT(DISTINCT a.name ORDER BY a.name SEPARATOR ', ') AS authors,
            COUNT(DISTINCT i.id) AS copies,
            COALESCE(SUM(CASE WHEN i.status = 'available' THEN 1 ELSE 0 END), 0) AS available,
            COALESCE(SUM(CASE WHEN i.status = 'checked_out' THEN 1 ELSE 0 END), 0) AS borrowed,
            GROUP_CONCAT(DISTINCT l.name ORDER BY l.name SEPARATOR ', ') AS location_list
        FROM editions e
        JOIN bib_records b        ON b.id = e.bib_record_id
        LEFT JOIN bib_authors ba  ON ba.bib_record_id = b.id
        LEFT JOIN authors a       ON a.id = ba.author_id
        LEFT JOIN items i         ON i.edition_id = e.id
        LEFT JOIN locations l     ON l.id = i.location_id
        WHERE 1 = 1
    ";
    $params = [];

    if ($search !== '') {
        // EXISTS subqueries (rather than filtering the outer LEFT JOINs
        // directly) so a title matched by search still reports its FULL
        // copy/available/borrowed counts, not just the counts of the
        // rows that happened to match.
        $sql .= " AND (
            b.title LIKE ? OR
            b.subtitle LIKE ? OR
            e.isbn LIKE ? OR
            EXISTS (
                SELECT 1 FROM bib_authors ba2
                JOIN authors a2 ON a2.id = ba2.author_id
                WHERE ba2.bib_record_id = b.id AND a2.name LIKE ?
            ) OR
            EXISTS (
                SELECT 1 FROM items ix
                WHERE ix.edition_id = e.id
                  AND (ix.accession_number LIKE ? OR ix.barcode LIKE ?)
            )
        )";
        $needle = '%' . $search . '%';
        array_push($params, $needle, $needle, $needle, $needle, $needle, $needle);
    }

    if ($locationId !== 0) {
        $sql .= " AND EXISTS (
            SELECT 1 FROM items iy WHERE iy.edition_id = e.id AND iy.location_id = ?
        )";
        $params[] = $locationId;
    }

    $sql .= " GROUP BY e.id ORDER BY b.title ASC";

    $stmt = $pdo->prepare($sql);
    $stmt->execute($params);
    $resultRows = $stmt->fetchAll();
}

$resultCount = count($resultRows);

/* ── Per-copy detail, for the modal (only for editions actually shown) ── */
$itemsByEdition = [];
if ($resultRows) {
    $editionIds = array_column($resultRows, 'edition_id');
    $placeholders = implode(',', array_fill(0, count($editionIds), '?'));

    $itemsStmt = $pdo->prepare("
        SELECT
            i.edition_id, i.barcode, i.accession_number, i.status,
            i.item_condition, i.date_acquired,
            l.name  AS location_name,
            c.name  AS collection_name,
            mt.name AS material_type
        FROM items i
        LEFT JOIN locations l      ON l.id = i.location_id
        LEFT JOIN collections c    ON c.id = i.collection_id
        LEFT JOIN material_types mt ON mt.id = i.material_type_id
        WHERE i.edition_id IN ($placeholders)
        ORDER BY i.accession_number, i.barcode
    ");
    $itemsStmt->execute($editionIds);

    foreach ($itemsStmt->fetchAll() as $item) {
        $itemsByEdition[$item['edition_id']][] = $item;
    }
}

foreach ($resultRows as &$row) {
    $row['items'] = $itemsByEdition[$row['edition_id']] ?? [];
}
unset($row);
