<script>
/* Live-submit the search form: debounce while typing, instant on location change. */
let debounceTimer;
const catalogForm = document.getElementById('catalogSearchForm');

document.getElementById('search').addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => catalogForm.requestSubmit(), 400);
});

document.getElementById('searchLocation').addEventListener('change', () => {
    catalogForm.requestSubmit();
});

/* ── Detail modal ── */
const EDITIONS_DATA = <?= json_encode($resultRows, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;

const STATUS_LABELS = {
    available: 'Available',
    checked_out: 'Checked Out',
    on_hold_shelf: 'On Hold Shelf',
    lost: 'Lost',
    withdrawn: 'Withdrawn',
    in_repair: 'In Repair',
};

function openBookDetail(editionId) {
    const e = EDITIONS_DATA.find(x => parseInt(x.edition_id) === editionId);
    if (!e) return;

    document.getElementById('dm-title').textContent    = e.title + (e.subtitle ? ': ' + e.subtitle : '');
    document.getElementById('dm-author').textContent   = e.authors || 'Unknown author';
    document.getElementById('dm-isbn').textContent      = e.isbn || '—';
    document.getElementById('dm-publisher').textContent = e.publisher || '—';
    document.getElementById('dm-year').textContent      = e.publication_year || '—';
    document.getElementById('dm-edition').textContent   = e.edition_statement || '—';
    document.getElementById('dm-format').textContent    = e.format || '—';
    document.getElementById('dm-copies').textContent    = e.copies ?? 0;
    document.getElementById('dm-available').textContent = e.available ?? 0;
    document.getElementById('dm-borrowed').textContent  = e.borrowed ?? 0;

    const body = document.getElementById('dm-copies-body');
    body.innerHTML = '';
    (e.items || []).forEach(item => {
        const tr = document.createElement('tr');
        const statusLabel = STATUS_LABELS[item.status] || item.status;
        tr.innerHTML = `
            <td>${item.barcode ?? '—'}</td>
            <td>${item.accession_number ?? '—'}</td>
            <td><span class="badge ${item.status === 'available' ? 'badge-available' : 'badge-out'}">${statusLabel}</span></td>
            <td>${item.item_condition ?? '—'}</td>
            <td>${item.location_name ?? '—'}</td>
        `;
        body.appendChild(tr);
    });
    if ((e.items || []).length === 0) {
        body.innerHTML = '<tr><td colspan="5" class="muted">No physical copies recorded yet.</td></tr>';
    }

    document.getElementById('detail-overlay').classList.add('open');
}
function closeBookDetail() {
    document.getElementById('detail-overlay').classList.remove('open');
}
document.getElementById('detail-overlay').addEventListener('click', function (e) {
    if (e.target === this) closeBookDetail();
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeBookDetail(); });
</script>
